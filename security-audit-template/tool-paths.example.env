# Security-audit-specific tool path overrides.
# Merge these entries with common-tools/tool-paths.example.env when creating tool-paths.env.
# The generic debug/developer variables live in common-tools so non-security workflows can use them too.
# Do not commit secrets or machine-specific paths unless the project explicitly intends to.

# Security audit tool roots
SECURITY_AUDIT_TOOL_ROOT=
SECURITY_AUDIT_MANIFEST_ROOT=

# Security/cross-platform audit tools
CHECKSEC_PATH=
SEMGREP_PATH=
GITLEAKS_PATH=
OSV_SCANNER_PATH=
TRUFFLEHOG_PATH=
FLAWFINDER_PATH=

# Optional strict coverage gate examples
# REQUIRED_AUDIT_TOOLS=semgrep,gitleaks,osv-scanner
# AUDIT_STRICT_REQUIRED_TOOLS=0

# Optional installer behavior toggles
# AUDIT_INSTALL_MINIMAL=0
# AUDIT_SKIP_SAST_INSTALL=0
# AUDIT_SKIP_SECRETS_INSTALL=0
# AUDIT_SKIP_DEPENDENCY_SCANNER_INSTALL=0
# AUDIT_INCLUDE_PYTHON_SAST=0
# AUDIT_INSTALL_FULL=0
# AUDIT_UNINSTALL=0
# AUDIT_REMOVE_SHARED_PACKAGES=0
# AUDIT_REMOVE_PYTHON_PACKAGES=0
